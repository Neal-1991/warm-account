.picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.picker-content {
  width: 100%;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  padding: 30rpx;
  max-height: 70vh;
}

.picker-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.manage {
  font-size: 28rpx;
  color: #FF9500;
}

.big-categories {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 30rpx;
}

.big-cat-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
}

.big-cat-item.active {
  background: #FFF5E6;
  border-radius: 12rpx;
}

.big-cat-item .icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.big-cat-item .name {
  font-size: 24rpx;
  color: #666;
}

.child-categories {
  display: flex;
  flex-wrap: wrap;
}

.child-item {
  padding: 16rpx 32rpx;
  background: #F5F5F5;
  border-radius: 32rpx;
  margin: 10rpx;
  font-size: 28rpx;
  color: #333;
}

.child-item.active {
  background: #FF9500;
  color: #FFFFFF;
}

.add-child {
  display: flex;
  margin-top: 20rpx;
}

.add-input {
  flex: 1;
  height: 72rpx;
  border: 1px solid #EEE;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
}

.add-btn {
  width: 150rpx;
  height: 72rpx;
  line-height: 72rpx;
  background: #FF9500;
  color: #FFF;
  border-radius: 8rpx;
  margin-left: 20rpx;
  font-size: 28rpx;
}

.picker-footer {
  margin-top: 30rpx;
}

.confirm-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #FF9500;
  color: #FFF;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: bold;
}