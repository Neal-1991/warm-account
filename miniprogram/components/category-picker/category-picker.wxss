.picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.picker-content {
  width: 100%;
  max-height: 70vh;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  padding: 30rpx;
}

.picker-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.manage {
  font-size: 28rpx;
  color: #07c160;
  padding: 8rpx 20rpx;
  background: rgba(7, 193, 96, 0.08);
  border-radius: 20rpx;
}

.big-categories {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 30rpx;
}

.big-cat-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
}

.big-cat-item.active {
  background: #e8f8ef;
  border-radius: 12rpx;
}

.big-cat-item .icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.big-cat-item .name {
  font-size: 24rpx;
  color: #666;
}

.big-cat-item.active .name {
  color: #07c160;
  font-weight: 600;
}

.add-big .add-icon {
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border: 2rpx dashed #ccc;
  border-radius: 50%;
  font-size: 36rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.add-big .name {
  color: #999;
}

/* 小类 */
.child-categories {
  display: flex;
  flex-wrap: wrap;
}

.child-item {
  padding: 16rpx 32rpx;
  background: #F5F5F5;
  border-radius: 32rpx;
  margin: 10rpx;
  font-size: 28rpx;
  color: #333;
}

.child-item.active {
  background: #07c160;
  color: #FFFFFF;
}

/* 大类入口 */
.child-item.big-entry {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #f0faf4;
  border: 2rpx dashed #b7ebce;
  border-radius: 16rpx;
  padding: 20rpx 32rpx;
  font-weight: 500;
}

.child-item.big-entry.active {
  background: #07c160;
  border-color: #07c160;
  color: #fff;
}

.big-entry-hint {
  font-size: 22rpx;
  color: #999;
  font-weight: 400;
}

.child-item.big-entry.active .big-entry-hint {
  color: rgba(255,255,255,0.7);
}

/* 添加大类表单 */
.add-big-form {
  margin-top: 20rpx;
}

.quick-emoji-picker {
  display: grid;
  grid-template-columns: repeat(8, 60rpx);
  gap: 12rpx;
  max-height: 204rpx;
  margin-bottom: 16rpx;
  overflow-y: auto;
}

.quick-emoji {
  width: 60rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  font-size: 36rpx;
  border: 2rpx solid transparent;
  border-radius: 8rpx;
  box-sizing: border-box;
}

.quick-emoji.selected {
  border-color: #07c160;
  background: #e8f8ef;
}

.add-big-fields {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.icon-input {
  width: 80rpx;
  height: 72rpx;
  border: 1px solid #EEE;
  border-radius: 8rpx;
  text-align: center;
  font-size: 32rpx;
}

.name-input {
  flex: 1;
  height: 72rpx;
  border: 1px solid #EEE;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
}

.add-child {
  display: flex;
  margin-top: 20rpx;
}

.add-input {
  flex: 1;
  height: 72rpx;
  border: 1px solid #EEE;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
}

.add-btn {
  width: 150rpx;
  height: 72rpx;
  line-height: 72rpx;
  background: #07c160;
  color: #FFF;
  border-radius: 8rpx;
  margin-left: 20rpx;
  font-size: 28rpx;
  padding: 0;
}

.picker-footer {
  margin-top: 30rpx;
}

.confirm-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #07c160;
  color: #FFF;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: bold;
}
