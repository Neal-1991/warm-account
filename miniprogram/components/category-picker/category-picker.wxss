.picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.picker-content {
  width: 100%;
  max-height: 90vh;
  background: var(--theme-surface, #FFFFFF);
  border-radius: 32rpx 32rpx 0 0;
  padding: 30rpx 30rpx 0;
  box-sizing: border-box;
}

.picker-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.title {
  font-size: 34rpx;
  font-weight: bold;
  color: var(--theme-text, #333);
}

.manage {
  font-size: 28rpx;
  color: var(--theme-accent, #6F8F4E);
  padding: 8rpx 20rpx;
  background: var(--theme-tint, #F1F5EA);
  border-radius: 20rpx;
}

.big-categories {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 30rpx;
}

.big-cat-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
}

.big-cat-item.active {
  background: var(--theme-tint, #F1F5EA);
  border-radius: 12rpx;
}

.big-cat-item .icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.big-cat-item .name {
  font-size: 24rpx;
  color: var(--theme-muted, #666);
}

.big-cat-item.active .name {
  color: var(--theme-accent, #6F8F4E);
  font-weight: 600;
}

.add-big .add-icon {
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border: 2rpx dashed var(--theme-border, #ccc);
  border-radius: 50%;
  font-size: 36rpx;
  color: var(--theme-muted, #999);
  margin-bottom: 8rpx;
}

.add-big .name {
  color: var(--theme-muted, #999);
}

/* 小类 */
.child-categories {
  display: flex;
  flex-wrap: wrap;
}

.child-item {
  padding: 16rpx 32rpx;
  background: var(--theme-bg, #F5F5F5);
  border-radius: 32rpx;
  margin: 10rpx;
  font-size: 28rpx;
  color: var(--theme-text, #333);
}

.child-item.active {
  background: var(--theme-accent, #6F8F4E);
  color: #FFFFFF;
}

/* 大类入口 */
.child-item.big-entry {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: var(--theme-tint, #f0faf4);
  border: 2rpx dashed var(--theme-border, #b7ebce);
  border-radius: 16rpx;
  padding: 20rpx 32rpx;
  font-weight: 500;
}

.child-item.big-entry.active {
  background: var(--theme-accent, #6F8F4E);
  border-color: var(--theme-accent, #6F8F4E);
  color: #fff;
}

.big-entry-hint {
  font-size: 22rpx;
  color: var(--theme-muted, #999);
  font-weight: 400;
}

.child-item.big-entry.active .big-entry-hint {
  color: rgba(255,255,255,0.7);
}

/* 添加大类表单 */
.add-big-form {
  margin-top: 20rpx;
}

.quick-icon-scroll {
  max-height: 330rpx;
  margin-top: 16rpx;
}

.quick-icon-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  padding-bottom: 4rpx;
}

.quick-icon {
  min-width: 0;
  height: 112rpx;
  padding: 10rpx 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx solid transparent;
  border-radius: 14rpx;
  background: var(--theme-bg, #F5F5F5);
  box-sizing: border-box;
}

.quick-icon image {
  width: 46rpx;
  height: 46rpx;
  flex: 0 0 auto;
}

.quick-icon-name {
  width: 100%;
  margin-top: 8rpx;
  color: var(--theme-muted, #666);
  font-size: 20rpx;
  line-height: 1.2;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.quick-icon.selected {
  border-color: var(--theme-accent, #6F8F4E);
  background: var(--theme-tint, #F1F5EA);
}

.quick-icon.selected .quick-icon-name {
  color: var(--theme-accent, #6F8F4E);
  font-weight: 600;
}

.add-big-fields {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.icon-input {
  width: 80rpx;
  height: 72rpx;
  border: 1px solid var(--theme-border, #EEE);
  border-radius: 8rpx;
  text-align: center;
  font-size: 32rpx;
}

.name-input {
  flex: 1;
  height: 72rpx;
  border: 1px solid var(--theme-border, #EEE);
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
}

.add-child {
  display: flex;
  margin-top: 20rpx;
}

.add-input {
  flex: 1;
  height: 72rpx;
  border: 1px solid var(--theme-border, #EEE);
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
}

.add-btn {
  width: 150rpx;
  height: 72rpx;
  line-height: 72rpx;
  background: var(--theme-accent, #6F8F4E);
  color: #FFF;
  border-radius: 8rpx;
  margin-left: 20rpx;
  font-size: 28rpx;
  padding: 0;
}

.picker-footer {
  padding: 20rpx 30rpx calc(20rpx + env(safe-area-inset-bottom));
  background: var(--theme-surface, #FFFFFF);
  flex-shrink: 0;
}

.confirm-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: var(--theme-accent, #6F8F4E);
  color: #FFF;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: bold;
}
