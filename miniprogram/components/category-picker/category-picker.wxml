<view class="picker-mask" bindtap="onClose" wx:if="{{visible}}">
  <view class="picker-content" catchtap="stopBubble">
    <view class="picker-header">
      <text class="title">选择分类</text>
      <text class="manage" bindtap="onManage">管理</text>
    </view>

    <view class="big-categories">
      <view
        wx:for="{{bigCategories}}"
        wx:key="id"
        class="big-cat-item {{selectedBigId === item.id ? 'active' : ''}}"
        bindtap="selectBig"
        data-id="{{item.id}}"
      >
        <text class="icon">{{item.icon}}</text>
        <text class="name">{{item.name}}</text>
      </view>
    </view>

    <view class="child-categories">
      <block wx:for="{{childCategories}}" wx:key="id">
        <view
          class="child-item {{selectedChildId === item.id ? 'active' : ''}}"
          bindtap="selectChild"
          data-id="{{item.id}}"
          data-name="{{item.name}}"
        >
          {{item.name}}
        </view>
      </block>
    </view>

    <view class="add-child" wx:if="{{showAddChild}}">
      <input class="add-input" placeholder="输入新分类名称" bindinput="onAddInput" value="{{newChildName}}" />
      <button class="add-btn" bindtap="confirmAddChild">添加</button>
    </view>

    <view class="picker-footer">
      <button class="confirm-btn" bindtap="onConfirm">确定</button>
    </view>
  </view>
</view>