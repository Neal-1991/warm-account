.record-card {
  display: flex;
  align-items: center;
  background: var(--theme-surface, #FFFFFF);
  margin: 15rpx 30rpx;
  padding: 25rpx;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.info {
  flex: 1;
  margin-left: 20rpx;
}

.category {
  font-size: 30rpx;
  color: var(--theme-text, #333);
  font-weight: 500;
}

.image-indicator {
  font-size: 24rpx;
  margin-left: 8rpx;
}

.remark {
  font-size: 24rpx;
  color: var(--theme-muted, #999);
  margin-top: 8rpx;
}

.amount-section {
  margin-right: 20rpx;
}

.amount {
  font-size: 32rpx;
  font-weight: bold;
}

.amount.expense {
  color: var(--color-expense, #D96F3D);
}

.amount.income {
  color: var(--color-income, #2F8F9D);
}

.meta {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.date {
  font-size: 22rpx;
  color: var(--theme-muted, #999);
}

.creator {
  font-size: 22rpx;
  color: var(--theme-muted, #CCC);
  margin-top: 8rpx;
}

.meta.date-hidden .creator {
  margin-top: 0;
}
