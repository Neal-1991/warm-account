.summary-card {
  margin: 20rpx 30rpx;
  border-radius: 16rpx;
  padding: 30rpx;
  color: var(--summary-text, #FFFFFF);
  background: var(--summary-bg, linear-gradient(135deg, var(--theme-accent, #6F8F4E) 0%, var(--theme-accent-soft, #A8B87A) 100%));
  border: 1px solid var(--summary-border, transparent);
  box-shadow: 0 12rpx 28rpx rgba(43, 57, 38, 0.14);
}

.month-label {
  text-align: center;
  font-size: 28rpx;
  opacity: 0.9;
  margin-bottom: 20rpx;
}

.summary-row {
  display: flex;
  justify-content: space-between;
}

.summary-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.label {
  font-size: 24rpx;
  opacity: 0.8;
  margin-bottom: 8rpx;
}

.value {
  font-size: 32rpx;
  font-weight: bold;
}

.expense {
  color: var(--summary-expense, #FFE8DE);
}

.income {
  color: var(--summary-income, #DBF4F7);
}

.balance {
  color: var(--summary-text, #FFFFFF);
}
