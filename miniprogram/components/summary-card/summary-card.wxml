<view class="summary-card" style="background: linear-gradient(135deg, #FF9500 0%, #FF6B00 100%);">
  <view class="month-label">{{month}}</view>
  <view class="summary-row">
    <view class="summary-item">
      <text class="label">支出</text>
      <text class="value expense">-¥{{expenseAmount}}</text>
    </view>
    <view class="summary-item">
      <text class="label">收入</text>
      <text class="value income">+¥{{incomeAmount}}</text>
    </view>
    <view class="summary-item">
      <text class="label">结余</text>
      <text class="value balance">¥{{balanceAmount}}</text>
    </view>
  </view>
</view>