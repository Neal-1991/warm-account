.container {
  padding-bottom: 120rpx;
  min-height: 100vh;
  background: #f7f8fa;
}

/* Tabs */
.tabs {
  display: flex;
  background: #fff;
  padding: 20rpx 30rpx;
  gap: 20rpx;
  position: sticky;
  top: 0;
  z-index: 100;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  background: #f5f5f5;
  color: #666;
}
.tab.active.expense {
  background: #fff0f0;
  color: #e74c3c;
  font-weight: 600;
}
.tab.active.income {
  background: #e8f8ef;
  color: #07c160;
  font-weight: 600;
}

/* Category list */
.category-list {
  padding: 20rpx 30rpx;
}
.big-section {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}
.big-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.big-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.big-icon { font-size: 40rpx; }
.big-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}
.big-sub-count {
  font-size: 24rpx;
  color: #999;
}
.tag {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  background: #fff0f0;
  color: #e74c3c;
}
.big-actions { display: flex; gap: 16rpx; }
.action-link {
  font-size: 26rpx;
  color: #07c160;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  background: rgba(7, 193, 96, 0.08);
}
.action-link.danger {
  color: #e74c3c;
  background: rgba(231, 76, 60, 0.08);
}

/* 子类 */
.child-list { padding: 10rpx 30rpx 20rpx; }
.child-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.child-row:last-child { border-bottom: none; }
.child-name { font-size: 28rpx; color: #555; }
.child-actions { display: flex; gap: 12rpx; }
.add-row { padding: 20rpx 0; }
.add-text { font-size: 26rpx; color: #07c160; }

/* Bottom bar */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 20rpx rgba(0,0,0,.06);
}
.add-big-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #07c160;
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 600;
}

/* Modal */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,.4);
  z-index: 2000;
  display: flex;
  align-items: center;
  justify-content: center;
}
.modal {
  width: 600rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx 30rpx 30rpx;
}
.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 24rpx;
  color: #333;
}
.modal-body { margin-bottom: 30rpx; }

.emoji-picker {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
  max-height: 240rpx;
  overflow-y: auto;
}
.emoji-opt {
  width: 60rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  font-size: 36rpx;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
}
.emoji-opt.selected {
  border-color: #07c160;
  background: #e8f8ef;
}

.rename-input {
  width: 100%;
  height: 72rpx;
  border: 1px solid #eee;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  margin-bottom: 16rpx;
}
.name-input { margin-top: 8rpx; }

.delete-hint {
  font-size: 28rpx;
  color: #666;
  text-align: center;
  margin-bottom: 20rpx;
  line-height: 1.6;
}
.delete-hint .count { color: #e74c3c; font-weight: 700; }

.merge-options { display: flex; flex-direction: column; gap: 12rpx; }
.merge-opt {
  padding: 20rpx;
  border: 1px solid #e0e0e0;
  border-radius: 12rpx;
  font-size: 28rpx;
  text-align: center;
  color: #333;
}
.merge-opt.primary {
  border-color: #07c160;
  background: #f0faf4;
  color: #07c160;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
}
.modal-btn {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  border-radius: 38rpx;
  font-size: 28rpx;
  padding: 0;
}
.modal-btn.cancel { background: #f5f5f5; color: #666; }
.modal-btn.confirm { background: #07c160; color: #fff; }
.modal-btn.danger { background: #e74c3c; color: #fff; }
