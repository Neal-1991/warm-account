.container {
  padding-bottom: 120rpx;
  min-height: 100vh;
  background: var(--theme-bg, #f7f8fa);
}

/* Tabs */
.tabs {
  display: flex;
  background: var(--theme-surface, #fff);
  padding: 20rpx 30rpx;
  gap: 20rpx;
  position: sticky;
  top: 0;
  z-index: 100;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  background: var(--theme-bg, #f5f5f5);
  color: var(--theme-muted, #666);
}
.tab.active.expense {
  background: #fff0f0;
  color: var(--color-expense, #e74c3c);
  font-weight: 600;
}
.tab.active.income {
  background: #EAF7FA;
  color: var(--color-income, #07c160);
  font-weight: 600;
}

/* Category list */
.category-list {
  padding: 20rpx 30rpx;
}
.big-section {
  background: var(--theme-surface, #fff);
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}
.big-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid var(--theme-border, #f0f0f0);
}
.big-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.big-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--theme-text, #333);
}
.big-sub-count {
  font-size: 24rpx;
  color: var(--theme-muted, #999);
}
.tag {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  background: #fff0f0;
  color: var(--color-expense, #e74c3c);
}
.big-actions {
  display: flex;
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: 12rpx;
}
.action-link {
  font-size: 26rpx;
  color: var(--theme-accent, #07c160);
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  background: var(--theme-tint, rgba(7, 193, 96, 0.08));
}
.action-link.subtle {
  color: var(--theme-muted, #666);
  background: var(--theme-bg, #f5f5f5);
}
.action-link.danger {
  color: var(--color-danger, #e74c3c);
  background: rgba(231, 76, 60, 0.08);
}

/* 子类 */
.child-list { padding: 10rpx 30rpx 20rpx; }
.child-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--theme-border, #f5f5f5);
}
.child-row:last-child { border-bottom: none; }
.child-name {
  flex: 1;
  margin-left: 12rpx;
  font-size: 28rpx;
  color: var(--theme-muted, #555);
}
.child-actions {
  display: flex;
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: 10rpx;
}
.add-row { padding: 20rpx 0; }
.add-text { font-size: 26rpx; color: var(--theme-accent, #07c160); }

/* Bottom bar */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: var(--theme-surface, #fff);
  box-shadow: 0 -2rpx 20rpx rgba(0,0,0,.06);
}
.add-big-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: var(--theme-accent, #07c160);
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 600;
}

/* Modal */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,.4);
  z-index: 2000;
  display: flex;
  align-items: center;
  justify-content: center;
}
.modal {
  width: 600rpx;
  max-height: 78vh;
  background: var(--theme-surface, #fff);
  border-radius: 20rpx;
  padding: 40rpx 30rpx 30rpx;
  box-sizing: border-box;
}
.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 24rpx;
  color: var(--theme-text, #333);
}
.modal-body { margin-bottom: 30rpx; }

.icon-grid-scroll {
  max-height: 360rpx;
  margin-bottom: 20rpx;
}

.icon-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  padding-bottom: 4rpx;
}

.icon-opt {
  min-width: 0;
  height: 112rpx;
  padding: 10rpx 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx solid transparent;
  border-radius: 14rpx;
  background: var(--theme-bg, #F5F5F5);
}

.icon-opt image {
  width: 46rpx;
  height: 46rpx;
  flex: 0 0 auto;
}

.icon-opt-name {
  width: 100%;
  margin-top: 8rpx;
  color: var(--theme-muted, #666);
  font-size: 20rpx;
  line-height: 1.2;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.icon-opt.selected {
  border-color: var(--theme-accent, #07c160);
  background: var(--theme-tint, #e8f8ef);
}

.icon-opt.selected .icon-opt-name {
  color: var(--theme-accent, #07c160);
  font-weight: 600;
}

.rename-input {
  width: 100%;
  height: 72rpx;
  border: 1px solid var(--theme-border, #eee);
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  margin-bottom: 16rpx;
}
.name-input { margin-top: 8rpx; }

.delete-hint {
  font-size: 28rpx;
  color: var(--theme-muted, #666);
  text-align: center;
  margin-bottom: 20rpx;
  line-height: 1.6;
}
.delete-hint .count { color: var(--color-danger, #e74c3c); font-weight: 700; }

.merge-options { display: flex; flex-direction: column; gap: 12rpx; }
.merge-opt {
  padding: 20rpx;
  border: 1px solid var(--theme-border, #e0e0e0);
  border-radius: 12rpx;
  font-size: 28rpx;
  text-align: center;
  color: var(--theme-text, #333);
}
.merge-opt.primary {
  border-color: var(--theme-accent, #07c160);
  background: var(--theme-tint, #f0faf4);
  color: var(--theme-accent, #07c160);
}

.modal-footer {
  display: flex;
  gap: 20rpx;
}
.modal-btn {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  border-radius: 38rpx;
  font-size: 28rpx;
  padding: 0;
}
.modal-btn.cancel { background: #f5f5f5; color: #666; }
.modal-btn.confirm { background: var(--theme-accent, #07c160); color: #fff; }
.modal-btn.danger { background: var(--color-danger, #e74c3c); color: #fff; }
