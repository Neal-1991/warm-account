.container {
  min-height: 100vh;
  background: #f5f5f5;
}

.family-info {
  background: #FFFFFF;
  padding: 40rpx 30rpx;
  margin-bottom: 20rpx;
}

.family-name {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 30rpx;
}

.invite-section {
  display: flex;
  flex-direction: column;
}

.invite-code {
  font-size: 36rpx;
  color: #FF9500;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.invite-buttons {
  display: flex;
}

.invite-btn,
.copy-btn {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 30rpx;
  font-size: 26rpx;
  border-radius: 32rpx;
  margin-right: 20rpx;
}

.invite-btn {
  background: #FF9500;
  color: #FFF;
}

.copy-btn {
  background: #F5F5F5;
  color: #666;
}

.member-section {
  background: #FFFFFF;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  color: #999;
  margin-bottom: 20rpx;
  display: block;
}

.member-list {
  display: flex;
  flex-direction: column;
}

.member-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1px solid #F0F0F0;
}

.member-item:last-child {
  border-bottom: none;
}

.member-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background: #F5F5F5;
}

.member-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.member-name {
  font-size: 30rpx;
  color: #333;
}

.member-role {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.remove-btn {
  font-size: 26rpx;
  color: #FF6B00;
}

.join-section {
  background: #FFFFFF;
  padding: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.code-input {
  width: 100%;
  height: 88rpx;
  border: 1px solid #EEE;
  border-radius: 44rpx;
  padding: 0 30rpx;
  font-size: 30rpx;
  text-align: center;
  margin-bottom: 30rpx;
}

.join-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #FF9500;
  color: #FFF;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: bold;
}