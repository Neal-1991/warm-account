.container {
  min-height: 100vh;
  background: var(--theme-bg, #f5f5f5);
}

.family-info {
  background: var(--theme-surface, #FFFFFF);
  padding: 40rpx 30rpx;
  margin-bottom: 20rpx;
}

.family-name {
  font-size: 40rpx;
  font-weight: bold;
  color: var(--theme-text, #333);
  display: block;
  margin-bottom: 30rpx;
}

.invite-section {
  display: flex;
  flex-direction: column;
}

.invite-code-hint {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.invite-code-label {
  font-size: 28rpx;
  color: var(--theme-muted, #999);
}

.invite-code-value {
  font-size: 36rpx;
  color: var(--theme-accent, #FF9500);
  font-weight: bold;
  margin-right: 12rpx;
}

.invite-code-tip {
  font-size: 22rpx;
  color: var(--theme-muted, #ccc);
  background: var(--theme-bg, #f5f5f5);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.invite-btn {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  background: var(--theme-accent, #FF9500);
  color: #FFF;
  border-radius: 40rpx;
  font-size: 30rpx;
  font-weight: bold;
  text-align: center;
}

.invite-btn::after {
  border: none;
}

/* ==================== 成员列表 ==================== */

.member-section {
  background: var(--theme-surface, #FFFFFF);
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  color: var(--theme-muted, #999);
  margin-bottom: 20rpx;
  display: block;
}

.member-list {
  display: flex;
  flex-direction: column;
}

.member-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1px solid var(--theme-border, #F0F0F0);
}

.member-item:last-child {
  border-bottom: none;
}

.member-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background: #F5F5F5;
}

.member-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.member-name {
  font-size: 30rpx;
  color: var(--theme-text, #333);
}

.member-role {
  font-size: 24rpx;
  color: var(--theme-muted, #999);
  margin-top: 4rpx;
}

.remove-btn {
  font-size: 26rpx;
  color: var(--color-danger, #FF6B00);
}

/* ==================== 弹窗 ==================== */

.dialog-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.dialog-card {
  width: 560rpx;
  background: var(--theme-surface, #FFFFFF);
  border-radius: 20rpx;
  overflow: hidden;
}

.dialog-body {
  padding: 50rpx 40rpx 40rpx;
  text-align: center;
}

.dialog-title {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--theme-text, #333);
  display: block;
  margin-bottom: 16rpx;
  line-height: 1.4;
}

.dialog-desc {
  font-size: 26rpx;
  color: var(--theme-muted, #999);
  display: block;
  line-height: 1.5;
}

.dialog-progress {
  display: block;
  margin-top: 20rpx;
  font-size: 24rpx;
  color: var(--theme-accent, #FF9500);
  line-height: 1.5;
}

.dialog-actions {
  display: flex;
  border-top: 1px solid var(--theme-border, #F0F0F0);
}

.dialog-actions-single {
  justify-content: center;
}

.dialog-btn-cancel,
.dialog-btn-confirm {
  flex: 1;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 30rpx;
  border-radius: 0;
  border: none;
  background: #FFFFFF;
  text-align: center;
}

.dialog-btn-cancel {
  color: var(--theme-muted, #999);
  border-right: 1px solid var(--theme-border, #F0F0F0);
}

.dialog-btn-confirm {
  color: var(--theme-accent, #FF9500);
  font-weight: bold;
}

.dialog-btn-cancel[disabled],
.dialog-btn-confirm[disabled] {
  color: #BBBBBB;
}

.dialog-btn-cancel::after,
.dialog-btn-confirm::after {
  border: none;
}
