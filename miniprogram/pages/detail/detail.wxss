.container {
  min-height: 100vh;
  background: var(--theme-bg, #f5f5f5);
  padding-bottom: 40rpx;
}

.info-card {
  background: var(--theme-surface, #FFFFFF);
  margin: 30rpx;
  padding: 40rpx;
  border-radius: 16rpx;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.category-row {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.category-name {
  margin-left: 12rpx;
  font-size: 30rpx;
  color: var(--theme-muted, #666);
}

.amount {
  font-size: 56rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.amount.expense {
  color: var(--color-expense, #FF6B00);
}

.amount.income {
  color: var(--color-income, #4CAF50);
}

.date {
  font-size: 26rpx;
  color: var(--theme-muted, #999);
}

.section {
  background: var(--theme-surface, #FFFFFF);
  margin: 0 30rpx 20rpx;
  padding: 30rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  display: block;
  font-size: 26rpx;
  color: var(--theme-muted, #999);
  margin-bottom: 16rpx;
}

.remark-content {
  font-size: 30rpx;
  color: var(--theme-text, #333);
  line-height: 1.6;
}

.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.record-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  background: #f0f0f0;
}

.meta-section {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.meta-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.meta-label {
  font-size: 28rpx;
  color: var(--theme-muted, #999);
}

.meta-value {
  font-size: 28rpx;
  color: var(--theme-text, #333);
}

.actions {
  margin: 40rpx 30rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.edit-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: var(--theme-accent, #FF9500);
  color: #FFFFFF;
  font-size: 30rpx;
  border-radius: 12rpx;
  text-align: center;
}

.edit-btn::after {
  border: none;
}

.delete-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #FFFFFF;
  color: var(--color-danger, #FF3B30);
  font-size: 30rpx;
  border-radius: 12rpx;
  border: 2rpx solid var(--color-danger, #FF3B30);
  text-align: center;
}

.delete-btn::after {
  border: none;
}

.empty-state {
  padding: 120rpx 30rpx;
  color: var(--theme-muted, #999);
  font-size: 28rpx;
  text-align: center;
}
