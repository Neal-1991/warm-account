/* miniprogram/pages/login/login.wxss */
.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
  background: linear-gradient(135deg, #FF9500 0%, #FF6B00 100%);
  color: #FFFFFF;
}

.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 80rpx;
}

.logo {
  width: 160rpx;
  height: 160rpx;
  border-radius: 32rpx;
  background: #FFFFFF;
  margin-bottom: 24rpx;
}

.app-name {
  font-size: 48rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.slogan {
  font-size: 28rpx;
  opacity: 0.9;
}

.agreement-section {
  width: 600rpx;
  text-align: center;
  margin-bottom: 60rpx;
}

.agreement-title {
  font-size: 26rpx;
  opacity: 0.8;
  margin-bottom: 20rpx;
}

.agreement-links {
  display: flex;
  justify-content: center;
  align-items: center;
}

.link {
  color: #FFFFFF;
  text-decoration: underline;
  font-size: 26rpx;
}

.separator {
  font-size: 26rpx;
  margin: 0 10rpx;
}

.login-btn {
  width: 600rpx;
  height: 96rpx;
  line-height: 96rpx;
  background: #FFFFFF;
  color: #FF9500;
  font-size: 34rpx;
  font-weight: bold;
  border-radius: 48rpx;
  border: none;
}

.login-btn::after {
  border: none;
}