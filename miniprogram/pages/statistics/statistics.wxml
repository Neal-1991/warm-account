<view class="container" style="{{themeStyle}}">
  <view class="header">
    <month-selector month="{{currentMonth}}" bindchange="onMonthChange" />
  </view>

  <view class="budget-strip" bindtap="goToBudget">
    <view wx:if="{{budgetView.configured}}">
      <text class="budget-strip-title">总预算已使用 {{budgetView.percent}}%</text>
      <text class="budget-strip-note">已花 ¥{{budgetView.usedAmount}} / ¥{{budgetView.limitAmount}}</text>
    </view>
    <view wx:else>
      <text class="budget-strip-title">
        {{budgetView.isHistorical ? '该月未设置分类预算' : (budgetView.canEdit ? '本月尚未设置分类预算' : '管理员暂未设置分类预算')}}
      </text>
      <text class="budget-strip-note">饼图和分类占比仍按实际支出展示</text>
    </view>
    <text wx:if="{{budgetView.configured || budgetView.canEdit}}" class="budget-strip-link">
      {{budgetView.configured ? '详情 ›' : '去设置 ›'}}
    </text>
  </view>

  <view class="chart-container">
    <ec-canvas id="pie-chart" canvas-id="pie-chart" ec="{{ecChart}}"></ec-canvas>
  </view>

  <view class="legend">
    <block wx:for="{{legend}}" wx:key="name">
      <view class="legend-item" bindtap="onLegendTap" data-name="{{item.name}}">
        <view class="legend-main">
          <view class="color-dot" style="background: {{item.color}};"></view>
          <view class="legend-icon">
            <category-icon icon-info="{{item.iconInfo}}" emoji="{{item.icon}}" size="small" />
          </view>
          <text class="name">{{item.name}}</text>
          <text class="amount">¥{{item.amount}}</text>
          <text class="percent">{{item.percent}}%</text>
        </view>
        <view wx:if="{{item.hasBudget}}" class="category-budget">
          <view class="category-budget-meta">
            <text>预算 ¥{{item.budgetAmount}}</text>
            <text class="{{item.budgetIsOver ? 'over-text' : (item.budgetStatus === 'warning' ? 'warning-text' : 'normal-text')}}">
              {{item.budgetIsOver ? '超支' : '剩余'}} ¥{{item.budgetRemainingAmount}}
            </text>
          </view>
          <view class="category-progress">
            <view
              class="category-progress-fill {{item.budgetStatus}}"
              style="width: {{item.budgetProgressWidth}}%;"
            ></view>
          </view>
        </view>
        <view wx:elif="{{budgetView.configured}}" class="no-category-budget">未单独设置分类预算</view>
      </view>
    </block>
    <view wx:if="{{legend.length === 0}}" class="empty">
      <text>本月暂无支出数据</text>
    </view>
  </view>

  <!-- 大类明细抽屉 -->
  <view wx:if="{{showDetailDrawer}}" class="drawer-mask" bindtap="closeDetailDrawer"></view>
  <view class="drawer {{showDetailDrawer ? 'open' : ''}}">
    <view class="drawer-header">
      <view class="drawer-title">
        <category-icon wx:if="{{activeBigIconInfo}}" icon-info="{{activeBigIconInfo}}" size="small" />
        <text class="drawer-name">{{activeBigName}}</text>
      </view>
      <view class="drawer-meta">
        <text class="drawer-count">{{activeBigCount}} 笔</text>
        <text class="drawer-amount">¥{{activeBigAmount}}</text>
      </view>
      <view class="drawer-close" bindtap="closeDetailDrawer">✕</view>
    </view>
    <scroll-view scroll-y class="drawer-body">
      <block wx:for="{{activeBigRecords}}" wx:key="_id">
        <view class="drawer-record" bindtap="onRecordTap" data-record-id="{{item._id}}">
          <category-icon icon-info="{{item.iconInfo}}" emoji="{{item.icon}}" size="normal" />
          <view class="drawer-record-info">
            <view class="drawer-record-category">
              {{item.categoryName}}
              <text wx:if="{{item.hasImages}}" class="drawer-record-images">📷</text>
            </view>
            <view class="drawer-record-remark" wx:if="{{item.remark}}">{{item.remark}}</view>
            <view class="drawer-record-meta">
              <text wx:if="{{item.dateStr}}" class="drawer-record-date">{{item.dateStr}}</text>
              <text class="drawer-record-creator">{{item.createdByName}}</text>
            </view>
          </view>
          <view class="drawer-record-amount">-¥{{item.amount}}</view>
        </view>
      </block>
      <view wx:if="{{activeBigRecords.length === 0}}" class="drawer-empty">
        <text>本月该大类暂无支出记录</text>
      </view>
    </scroll-view>
  </view>
</view>
