.container {
  min-height: 100vh;
  background: #f5f5f5;
}

.header {
  background: #FFFFFF;
}

.chart-container {
  background: #FFFFFF;
  margin: 20rpx 30rpx;
  border-radius: 16rpx;
  padding: 20rpx;
  height: 500rpx;
}

.chart-container ec-canvas {
  width: 100%;
  height: 100%;
}

.legend {
  background: #FFFFFF;
  margin: 20rpx 30rpx;
  border-radius: 16rpx;
  padding: 30rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1px solid #F0F0F0;
}

.legend-item:last-child {
  border-bottom: none;
}

.color-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.legend-item .name {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.legend-item .amount {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-right: 20rpx;
}

.legend-item .percent {
  font-size: 24rpx;
  color: #999;
  width: 100rpx;
  text-align: right;
}

.empty {
  display: flex;
  justify-content: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 28rpx;
}