.container {
  min-height: 100vh;
  background: #f5f5f5;
}

.header {
  background: #FFFFFF;
}

.record-list {
  padding-bottom: 150rpx;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  color: #999;
}

.empty text {
  font-size: 28rpx;
}

.empty-hint {
  font-size: 24rpx;
  margin-top: 20rpx;
}

.add-btn {
  position: fixed;
  right: 40rpx;
  bottom: 200rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF9500 0%, #FF6B00 100%);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 0, 0.4);
  z-index: 100;
}

.add-btn text {
  font-size: 60rpx;
  font-weight: 300;
  line-height: 1;
}