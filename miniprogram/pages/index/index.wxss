.container {
  min-height: 100vh;
  background: var(--theme-bg, #F4F6F2);
}

.header {
  background: var(--theme-surface, #FFFFFF);
}

.budget-card {
  margin: 20rpx 30rpx;
  padding: 30rpx;
  background: var(--theme-surface, #FFFFFF);
  border: 1px solid var(--theme-border, transparent);
  border-radius: 16rpx;
}

.budget-header,
.budget-main,
.budget-meta {
  display: flex;
  align-items: center;
}

.budget-header {
  justify-content: space-between;
}

.budget-title {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--theme-text, #333333);
}

.budget-detail {
  color: var(--theme-accent, #6F8F4E);
  font-size: 24rpx;
}

.budget-main {
  margin: 28rpx 0 18rpx;
  align-items: flex-end;
}

.budget-remaining {
  font-size: 54rpx;
  font-weight: bold;
  color: var(--theme-text, #333333);
}

.budget-unit {
  margin: 0 0 8rpx 10rpx;
  color: var(--theme-muted, #999999);
  font-size: 24rpx;
}

.budget-percent {
  margin: 0 0 8rpx auto;
  color: var(--color-success, #5E9B72);
  font-size: 26rpx;
  font-weight: bold;
}

.budget-percent.warning {
  color: var(--color-warning, #D9902F);
}

.budget-percent.over {
  color: var(--color-danger, #D94A43);
}

.budget-progress {
  height: 16rpx;
  overflow: hidden;
  background: var(--theme-border, #EEEEEE);
  border-radius: 16rpx;
}

.budget-progress-fill {
  height: 100%;
  background: var(--color-success, #5E9B72);
  border-radius: 16rpx;
}

.budget-progress-fill.warning {
  background: var(--color-warning, #D9902F);
}

.budget-progress-fill.over {
  background: var(--color-danger, #D94A43);
}

.budget-meta {
  justify-content: space-between;
  margin-top: 14rpx;
  color: var(--theme-muted, #888888);
  font-size: 22rpx;
}

.budget-pace {
  margin-top: 22rpx;
  padding: 20rpx 24rpx;
  color: var(--color-warning, #8F5A0C);
  font-size: 22rpx;
  background: var(--theme-tint, #FFF7E9);
  border-radius: 12rpx;
}

.budget-empty {
  padding: 28rpx 0 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.budget-empty-icon {
  width: 90rpx;
  height: 90rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--theme-tint, #FFF1DD);
  border-radius: 28rpx;
  font-size: 40rpx;
}

.budget-empty-title {
  margin-top: 18rpx;
  color: var(--theme-text, #333333);
  font-size: 28rpx;
  font-weight: bold;
}

.budget-empty-note {
  margin-top: 10rpx;
  color: var(--theme-muted, #999999);
  font-size: 22rpx;
}

.budget-set-btn {
  margin-top: 22rpx;
  padding: 0 34rpx;
  height: 70rpx;
  line-height: 70rpx;
  color: #FFFFFF;
  background: var(--theme-accent, #FF9500);
  border-radius: 35rpx;
  font-size: 24rpx;
}

.budget-set-btn::after {
  border: none;
}

.record-list {
  padding-bottom: 150rpx;
}

.day-group {
  margin-top: 10rpx;
}

.day-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 22rpx 30rpx 8rpx;
}

.day-title-wrap {
  display: flex;
  align-items: baseline;
}

.day-title {
  color: var(--theme-text, #333333);
  font-size: 32rpx;
  font-weight: bold;
}

.day-subtitle {
  margin-left: 12rpx;
  color: var(--theme-muted, #999999);
  font-size: 22rpx;
}

.day-total {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  color: var(--theme-muted, #999999);
  font-size: 22rpx;
  line-height: 1.35;
}

.day-income {
  color: var(--color-income, #2F8F9D);
  font-weight: 500;
}

.day-expense {
  color: var(--color-expense, #D96F3D);
  font-weight: 500;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  color: var(--theme-muted, #999);
}

.empty text {
  font-size: 28rpx;
}

.empty-hint {
  font-size: 24rpx;
  margin-top: 20rpx;
}

.add-btn {
  position: fixed;
  right: 40rpx;
  bottom: 200rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--theme-accent, #6F8F4E) 0%, var(--theme-accent-soft, #A8B87A) 100%);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(43, 57, 38, 0.24);
  z-index: 100;
}

.add-btn-hover {
  opacity: 0.85;
  transform: scale(0.94);
}

.add-btn text {
  font-size: 60rpx;
  font-weight: 300;
  line-height: 1;
}

.mic-btn {
  position: fixed;
  right: 60rpx;
  bottom: 120rpx;
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: var(--theme-surface, #FFFFFF);
  box-shadow: 0 4rpx 16rpx rgba(43, 57, 38, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
  border: 2rpx solid var(--theme-accent, #6F8F4E);
}

.mic-btn-hover {
  opacity: 0.85;
  transform: scale(0.94);
}

.mic-btn text {
  font-size: 30rpx;
  line-height: 1;
}
