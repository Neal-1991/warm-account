<view class="container" style="{{themeStyle}}">
  <view class="month-header">
    <month-selector month="{{currentMonth}}" bindchange="onMonthChange" />
  </view>

  <view wx:if="{{loading}}" class="loading">预算加载中...</view>

  <block wx:else>
    <view class="page-header">
      <view>
        <view class="page-title">{{currentMonthDisplay}}预算</view>
        <view class="page-note" wx:if="{{isHistorical}}">历史月份预算只读，保留当时的家庭消费计划</view>
        <view class="page-note" wx:elif="{{!canEdit}}">你可以查看家庭预算，仅账本管理员可以修改</view>
        <view class="page-note" wx:else>家庭预算由管理员设置，全体家庭成员都可以查看</view>
      </view>
      <text wx:if="{{canEdit && !budget}}" class="copy-link" bindtap="copyPrevious">复制上月</text>
    </view>

    <view wx:if="{{!editing}}" class="empty-card">
      <view class="empty-icon">📝</view>
      <view class="empty-title">{{canEdit ? '创建本月预算' : '该月未设置预算'}}</view>
      <view class="empty-note">
        {{canEdit ? '先设置家庭总预算，再选择需要重点控制的支出大类' : '没有预算数据，账目记录和统计不受影响'}}
      </view>
      <button wx:if="{{canEdit}}" class="start-btn" bindtap="startEditing">开始设置</button>
    </view>

    <block wx:else>
      <view wx:if="{{budgetView.configured}}" class="overview-card {{budgetView.status}}">
        <view class="overview-top">
          <view>
            <view class="overview-label">{{budgetView.summaryLabel}}</view>
            <view class="overview-amount">{{budgetView.isOver ? '-' : ''}}¥{{budgetView.remainingAmount}}</view>
          </view>
          <view class="overview-percent">{{budgetView.percent}}%</view>
        </view>
        <view class="overview-progress">
          <view
            class="overview-progress-fill"
            style="width: {{budgetView.progressWidth}}%;"
          ></view>
        </view>
        <view class="overview-meta">
          <text>已花 ¥{{budgetView.usedAmount}}</text>
          <text>预算 ¥{{budgetView.limitAmount}}</text>
        </view>
        <view wx:if="{{budgetView.paceText}}" class="overview-pace">{{budgetView.paceText}}</view>
      </view>

      <view class="form-card {{canEdit ? '' : 'readonly'}}">
        <view class="field-label">家庭总预算</view>
        <view class="amount-row">
          <text class="currency">¥</text>
          <input
            class="amount-input"
            type="digit"
            value="{{totalAmount}}"
            disabled="{{!canEdit}}"
            bindinput="onTotalInput"
            placeholder="0.00"
          />
        </view>
        <view class="field-note">总预算与分类预算分别预警，分类预算不必分完总额</view>
      </view>

      <view class="form-card {{canEdit ? '' : 'readonly'}}">
        <view class="category-header">
          <text class="card-title">大类预算</text>
          <text wx:if="{{canEdit}}" class="add-link" bindtap="showAddCategory">+ 添加分类</text>
        </view>
        <view wx:if="{{categoryLimits.length === 0}}" class="category-empty">暂未设置分类预算</view>
        <view
          wx:for="{{categoryLimits}}"
          wx:key="categoryId"
          class="category-row"
        >
          <view class="category-icon-wrap">
            <category-icon icon-info="{{item.iconInfo}}" emoji="{{item.icon}}" size="small" />
          </view>
          <view class="category-copy">
            <text class="category-name">{{item.name}}</text>
            <text wx:if="{{budget}}" class="category-usage">已用 ¥{{item.usedAmount}} · {{item.percent}}%</text>
          </view>
          <view class="category-amount">
            <text>¥</text>
            <input
              type="digit"
              value="{{item.amount}}"
              disabled="{{!canEdit || !item.categoryExists}}"
              data-index="{{index}}"
              bindinput="onCategoryAmountInput"
              placeholder="0.00"
            />
          </view>
          <text wx:if="{{canEdit}}" class="remove-category" data-index="{{index}}" bindtap="removeCategory">移除</text>
          <view wx:if="{{budget}}" class="category-progress">
            <view
              class="category-progress-fill {{item.status}}"
              style="width: {{item.progressWidth}}%;"
            ></view>
          </view>
        </view>
      </view>

      <view wx:if="{{canEdit}}" class="action-space"></view>
      <view wx:if="{{canEdit}}" class="bottom-actions">
        <button wx:if="{{budget}}" class="delete-btn" bindtap="removeBudget">删除</button>
        <button class="save-btn" bindtap="saveBudget" loading="{{saving}}">保存预算</button>
      </view>
    </block>
  </block>

  <view wx:if="{{showCategoryModal}}" class="modal-mask" bindtap="hideAddCategory">
    <view class="category-modal" catchtap="noop">
      <view class="modal-title">选择支出大类</view>
      <scroll-view class="modal-list" scroll-y>
        <view
          wx:for="{{availableCategories}}"
          wx:key="_id"
          class="modal-category"
          data-category-id="{{item._id}}"
          bindtap="addCategory"
        >
          <view class="category-icon-wrap">
            <category-icon icon-info="{{item.iconInfo}}" emoji="{{item.icon}}" size="small" />
          </view>
          <text>{{item.name}}</text>
        </view>
      </scroll-view>
      <button class="modal-cancel" bindtap="hideAddCategory">取消</button>
    </view>
  </view>
</view>
