.container {
  min-height: 100vh;
  padding-bottom: 130rpx;
  background: #F5F5F5;
}

.month-header,
.page-header,
.form-card {
  background: #FFFFFF;
}

.page-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 28rpx 30rpx;
  border-top: 1px solid #F0F0F0;
}

.page-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}

.page-note {
  margin-top: 10rpx;
  color: #999999;
  font-size: 22rpx;
}

.copy-link,
.add-link {
  color: #FF7900;
  font-size: 24rpx;
  font-weight: 500;
}

.loading {
  padding: 120rpx 0;
  color: #999999;
  text-align: center;
}

.empty-card {
  margin: 24rpx 30rpx;
  padding: 70rpx 30rpx;
  text-align: center;
  background: #FFFFFF;
  border-radius: 20rpx;
}

.empty-icon {
  width: 96rpx;
  height: 96rpx;
  margin: 0 auto 20rpx;
  font-size: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFF1DD;
  border-radius: 30rpx;
}

.empty-title {
  font-size: 30rpx;
  font-weight: bold;
}

.empty-note {
  margin-top: 14rpx;
  color: #999999;
  font-size: 24rpx;
  line-height: 1.6;
}

.overview-card {
  margin: 20rpx 30rpx;
  padding: 30rpx;
  color: #FFFFFF;
  background: linear-gradient(135deg, #FFB347, #FF8A00);
  border-radius: 20rpx;
}

.overview-card.warning {
  background: linear-gradient(135deg, #F6A623, #E78300);
}

.overview-card.over {
  background: linear-gradient(135deg, #F47A72, #D94A43);
}

.overview-top,
.overview-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.overview-label,
.overview-meta,
.overview-pace {
  font-size: 22rpx;
  opacity: 0.9;
}

.overview-amount {
  margin-top: 8rpx;
  font-size: 50rpx;
  font-weight: bold;
}

.overview-percent {
  font-size: 34rpx;
  font-weight: bold;
}

.overview-progress {
  height: 12rpx;
  margin: 24rpx 0 14rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.35);
  border-radius: 8rpx;
}

.overview-progress-fill {
  height: 100%;
  background: #FFFFFF;
  border-radius: 8rpx;
}

.overview-pace {
  margin-top: 16rpx;
}

.start-btn {
  width: 240rpx;
  margin-top: 28rpx;
  color: #FFFFFF;
  background: #FF9500;
  border-radius: 44rpx;
  font-size: 28rpx;
}

.start-btn::after,
.delete-btn::after,
.save-btn::after,
.modal-cancel::after {
  border: none;
}

.form-card {
  margin-top: 20rpx;
  padding: 30rpx;
}

.form-card.readonly {
  color: #999999;
  background: #FAFAFA;
}

.field-label {
  margin-bottom: 18rpx;
  color: #666666;
  font-size: 24rpx;
}

.amount-row {
  display: flex;
  align-items: center;
  padding-bottom: 18rpx;
  border-bottom: 1px solid #EEEEEE;
}

.currency {
  font-size: 44rpx;
  font-weight: bold;
}

.amount-input {
  flex: 1;
  margin-left: 12rpx;
  font-size: 56rpx;
  font-weight: bold;
}

.field-note {
  margin-top: 14rpx;
  color: #AAAAAA;
  font-size: 22rpx;
}

.category-header,
.category-row {
  display: flex;
  align-items: center;
}

.category-header {
  justify-content: space-between;
}

.card-title {
  font-size: 30rpx;
  font-weight: bold;
}

.category-row {
  position: relative;
  flex-wrap: wrap;
  min-height: 98rpx;
  padding: 18rpx 0;
  border-bottom: 1px solid #F0F0F0;
}

.category-row:last-child {
  border-bottom: none;
}

.category-icon {
  width: 58rpx;
  font-size: 34rpx;
}

.category-copy {
  flex: 1;
  min-width: 0;
}

.category-name,
.category-usage {
  display: block;
}

.category-name {
  font-size: 28rpx;
}

.category-usage {
  margin-top: 8rpx;
  color: #999999;
  font-size: 20rpx;
}

.category-amount {
  width: 210rpx;
  display: flex;
  align-items: center;
  padding: 12rpx 16rpx;
  background: #F5F5F5;
  border-radius: 12rpx;
}

.category-amount input {
  min-width: 0;
  flex: 1;
  text-align: right;
}

.remove-category {
  margin-left: 18rpx;
  color: #F45B55;
  font-size: 22rpx;
}

.category-progress {
  flex-basis: calc(100% - 58rpx);
  height: 8rpx;
  margin: 14rpx 0 0 58rpx;
  overflow: hidden;
  background: #EEEEEE;
  border-radius: 6rpx;
}

.category-progress-fill {
  height: 100%;
  background: #59B67A;
  border-radius: 6rpx;
}

.category-progress-fill.warning {
  background: #F5A623;
}

.category-progress-fill.over {
  background: #E95C54;
}

.category-empty {
  padding: 50rpx 0 20rpx;
  color: #AAAAAA;
  text-align: center;
  font-size: 24rpx;
}

.action-space {
  height: 120rpx;
}

.bottom-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 30rpx 30rpx;
  background: #FFFFFF;
  border-top: 1px solid #EEEEEE;
}

.delete-btn,
.save-btn {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
}

.delete-btn {
  width: 180rpx;
  color: #F45B55;
  background: #FFF1F0;
}

.save-btn {
  flex: 1;
  color: #FFFFFF;
  background: #FF9500;
}

.modal-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.45);
}

.category-modal {
  width: 100%;
  max-height: 70vh;
  padding: 30rpx;
  background: #FFFFFF;
  border-radius: 28rpx 28rpx 0 0;
}

.modal-title {
  margin-bottom: 24rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: bold;
}

.modal-list {
  max-height: 50vh;
  overflow-y: auto;
}

.modal-category {
  display: flex;
  align-items: center;
  padding: 24rpx 10rpx;
  border-bottom: 1px solid #F0F0F0;
}

.modal-cancel {
  margin-top: 24rpx;
  background: #F5F5F5;
  border-radius: 44rpx;
}
