.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 120rpx;
}

.form {
  background: #FFFFFF;
  margin-bottom: 20rpx;
}

.type-switch {
  display: flex;
  padding: 30rpx;
  border-bottom: 1px solid #F0F0F0;
}

.type-switch view {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 32rpx;
  color: #999;
  border-radius: 8rpx;
}

.type-switch view.active {
  background: #FF9500;
  color: #FFFFFF;
}

.amount-section {
  display: flex;
  align-items: center;
  padding: 40rpx 30rpx;
  border-bottom: 1px solid #F0F0F0;
}

.currency {
  font-size: 48rpx;
  color: #333;
  margin-right: 10rpx;
}

.amount-input {
  flex: 1;
  font-size: 56rpx;
  color: #333;
  font-weight: bold;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1px solid #F0F0F0;
}

.label {
  font-size: 30rpx;
  color: #333;
  width: 120rpx;
}

.value {
  flex: 1;
  display: flex;
  align-items: center;
}

.category-icon {
  font-size: 36rpx;
  margin-right: 10rpx;
}

.category-name {
  font-size: 30rpx;
  color: #666;
}

.remark-input {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

.arrow {
  color: #CCC;
  margin-left: 10rpx;
}

.images-section {
  display: flex;
  flex-wrap: wrap;
  flex: 1;
}

.image-item {
  width: 160rpx;
  height: 160rpx;
  margin-right: 20rpx;
  margin-bottom: 20rpx;
  position: relative;
}

.image-item image {
  width: 100%;
  height: 100%;
  border-radius: 8rpx;
}

.image-item .remove {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 36rpx;
  height: 36rpx;
  background: rgba(0, 0, 0, 0.5);
  color: #FFF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

.add-image {
  width: 160rpx;
  height: 160rpx;
  background: #F5F5F5;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-image text {
  font-size: 60rpx;
  color: #999;
}

.submit-btn {
  position: fixed;
  bottom: 40rpx;
  left: 30rpx;
  right: 30rpx;
  height: 88rpx;
  line-height: 88rpx;
  background: #FF9500;
  color: #FFF;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: bold;
}

.submit-btn[disabled] {
  background: #CCC;
}