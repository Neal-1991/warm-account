.container {
  min-height: 100vh;
  background: var(--theme-bg, #f5f5f5);
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.form {
  background: var(--theme-surface, #FFFFFF);
  margin-bottom: 20rpx;
}

.type-switch {
  display: flex;
  padding: 30rpx;
  border-bottom: 1px solid var(--theme-border, #F0F0F0);
}

.type-switch view {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 32rpx;
  color: #999;
  border-radius: 8rpx;
}

.type-switch view.active {
  background: var(--theme-accent, #FF9500);
  color: #FFFFFF;
}

.amount-section {
  display: flex;
  align-items: center;
  padding: 40rpx 30rpx;
  border-bottom: 1px solid var(--theme-border, #F0F0F0);
}

.currency {
  font-size: 48rpx;
  color: var(--theme-text, #333);
  margin-right: 10rpx;
}

.amount-input {
  flex: 1;
  font-size: 56rpx;
  color: var(--theme-text, #333);
  font-weight: bold;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1px solid var(--theme-border, #F0F0F0);
}

.label {
  font-size: 30rpx;
  color: var(--theme-text, #333);
  width: 120rpx;
}

.value {
  flex: 1;
  display: flex;
  align-items: center;
}

.category-name {
  margin-left: 12rpx;
  font-size: 30rpx;
  color: var(--theme-muted, #666);
}

.remark-input {
  flex: 1;
  font-size: 30rpx;
  color: var(--theme-text, #333);
}

.arrow {
  color: #CCC;
  margin-left: 10rpx;
}

.images-section {
  display: flex;
  flex-wrap: wrap;
  flex: 1;
}

.image-item {
  width: 160rpx;
  height: 160rpx;
  margin-right: 20rpx;
  margin-bottom: 20rpx;
  position: relative;
}

.image-item image {
  width: 100%;
  height: 100%;
  border-radius: 8rpx;
}

.image-item .remove {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 36rpx;
  height: 36rpx;
  background: rgba(0, 0, 0, 0.5);
  color: #FFF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

.add-image {
  width: 160rpx;
  height: 160rpx;
  background: #F5F5F5;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-image text {
  font-size: 60rpx;
  color: #999;
}

.submit-btn {
  position: fixed;
  bottom: calc(40rpx + env(safe-area-inset-bottom));
  left: 30rpx;
  right: 30rpx;
  height: 88rpx;
  line-height: 88rpx;
  background: var(--theme-accent, #FF9500);
  color: #FFF;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: bold;
  box-sizing: border-box;
  text-align: center;
}

.submit-btn.disabled {
  background: #CCC;
  color: #FFF;
}

.budget-notice {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(146rpx + env(safe-area-inset-bottom));
  z-index: 2000;
  display: flex;
  align-items: center;
  padding: 24rpx 26rpx;
  color: #FFFFFF;
  background: #3B3028;
  border-radius: 24rpx;
  box-shadow: 0 16rpx 44rpx rgba(35, 24, 18, 0.28);
  animation: budget-notice-in 0.25s ease-out;
}

.budget-notice-icon {
  flex: 0 0 58rpx;
  width: 58rpx;
  height: 58rpx;
  margin-right: 20rpx;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-warning, #D68418);
  border-radius: 50%;
}

.budget-notice.over .budget-notice-icon {
  background: var(--color-danger, #F45B55);
}

.budget-notice-content {
  flex: 1;
  min-width: 0;
}

.budget-notice-title {
  font-size: 28rpx;
  font-weight: bold;
  line-height: 1.4;
}

.budget-notice-message {
  margin-top: 6rpx;
  color: #EADFD5;
  font-size: 24rpx;
  line-height: 1.4;
}

@keyframes budget-notice-in {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
