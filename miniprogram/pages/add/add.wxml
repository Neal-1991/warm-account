<view class="container">
  <view class="form">
    <!-- 类型切换 -->
    <view class="type-switch">
      <view class="{{type === 'expense' ? 'active' : ''}}" bindtap="switchType" data-type="expense">支出</view>
      <view class="{{type === 'income' ? 'active' : ''}}" bindtap="switchType" data-type="income">收入</view>
    </view>

    <!-- 金额输入 -->
    <view class="amount-section">
      <text class="currency">¥</text>
      <input class="amount-input" type="digit" placeholder="0.00" bindinput="onAmountInput" value="{{amount}}" />
    </view>

    <!-- 分类选择 -->
    <view class="form-item" bindtap="openCategoryPicker">
      <text class="label">分类</text>
      <view class="value">
        <text class="category-icon">{{selectedCategory.icon}}</text>
        <text class="category-name">{{selectedCategory.name || '请选择'}}</text>
        <text class="arrow">›</text>
      </view>
    </view>

    <!-- 日期选择 -->
    <view class="form-item">
      <text class="label">日期</text>
      <picker mode="date" value="{{date}}" bindchange="onDateChange">
        <view class="value">
          <text>{{dateDisplay}}</text>
          <text class="arrow">›</text>
        </view>
      </picker>
    </view>

    <!-- 备注 -->
    <view class="form-item">
      <text class="label">备注</text>
      <input class="remark-input" placeholder="选填" bindinput="onRemarkInput" value="{{remark}}" />
    </view>

    <!-- 图片上传 -->
    <view class="form-item">
      <text class="label">图片</text>
      <view class="images-section">
        <view class="image-item" wx:for="{{images}}" wx:key="*this">
          <image src="{{item}}" mode="aspectFill" />
          <text class="remove" bindtap="removeImage" data-index="{{index}}">x</text>
        </view>
        <view class="add-image" bindtap="addImage" wx:if="{{images.length < 9}}">
          <text>+</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 提交按钮 -->
  <button class="submit-btn" type="primary" bindtap="onSubmit" disabled="{{!canSubmit}}">提交</button>

  <!-- 分类选择器 -->
  <category-picker
    visible="{{showCategoryPicker}}"
    categories="{{categories}}"
    type="{{type}}"
    bind:select="onCategorySelect"
    bind:close="closeCategoryPicker"
    bind:addchild="onAddChild"
  />
</view>