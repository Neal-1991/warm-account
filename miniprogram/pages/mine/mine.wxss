.container {
  min-height: 100vh;
  background: var(--theme-bg, #f5f5f5);
}

.profile-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
  background: linear-gradient(135deg, var(--theme-accent, #FF9500) 0%, var(--theme-accent-soft, #FFB347) 100%);
  color: #FFFFFF;
}

.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #FFFFFF;
  margin-bottom: 24rpx;
}

.nickname {
  font-size: 36rpx;
  font-weight: bold;
}

.menu-list {
  background: var(--theme-surface, #FFFFFF);
  margin: 20rpx 0;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1px solid var(--theme-border, #F0F0F0);
}

.menu-item:last-child {
  border-bottom: none;
}

.icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.label {
  flex: 1;
  font-size: 30rpx;
  color: var(--theme-text, #333);
}

.menu-status {
  margin-right: 12rpx;
  color: var(--theme-muted, #999999);
  font-size: 22rpx;
}

.arrow {
  color: #CCC;
  font-size: 28rpx;
}

.logout-btn {
  margin: 40rpx 30rpx;
  height: 88rpx;
  line-height: 88rpx;
  background: #FFFFFF;
  color: var(--color-danger, #FF6B00);
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: bold;
}

.logout-btn::after {
  border: none;
}

.login-btn {
  margin: 40rpx 30rpx;
  height: 88rpx;
  line-height: 88rpx;
  background: var(--theme-accent, #FF9500);
  color: #FFFFFF;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: bold;
}

.login-btn::after {
  border: none;
}

/* 头像区域 */
.avatar-section {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.edit-btn {
  position: absolute;
  bottom: 0;
  right: -20rpx;
  width: 56rpx;
  height: 56rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

/* 编辑弹窗 */
.edit-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.edit-modal-content {
  width: 600rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 1px solid #F0F0F0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--theme-text, #333);
}

.modal-close {
  font-size: 40rpx;
  color: #999;
}

.modal-body {
  padding: 50rpx 40rpx 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 头像按钮 */
.avatar-btn {
  position: relative;
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  overflow: hidden;
  padding: 0;
  margin: 0 0 40rpx;
  background: none;
  border: none;
  line-height: 0;
}

.avatar-btn::after {
  border: none;
}

.avatar-preview {
  width: 100%;
  height: 100%;
}

/* 头像下半透明遮罩 + 更换提示 */
.avatar-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 72rpx;
  background: rgba(0, 0, 0, 0.4);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
}

.avatar-overlay-icon {
  font-size: 24rpx;
  line-height: 1;
}

.avatar-overlay-text {
  font-size: 20rpx;
  color: #FFFFFF;
  line-height: 1;
}

/* 昵称区域 */
.nickname-section {
  width: 100%;
}

.nickname-input {
  width: 100%;
  height: 88rpx;
  background: var(--theme-bg, #F5F5F5);
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 32rpx;
  color: var(--theme-text, #333);
  text-align: center;
}

.nickname-hint {
  text-align: center;
  font-size: 22rpx;
  color: var(--theme-muted, #CCC);
  margin-top: 12rpx;
}

.modal-actions {
  padding: 30rpx;
  display: flex;
  gap: 20rpx;
}

.btn-cancel {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  background: #F5F5F5;
  color: #666;
  border-radius: 44rpx;
  font-size: 32rpx;
}

.btn-save {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  background: var(--theme-accent, #FF9500);
  color: #FFFFFF;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: bold;
}

.btn-cancel::after,
.btn-save::after {
  border: none;
}

.theme-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.45);
}

.theme-panel {
  width: 100%;
  max-height: 78vh;
  display: flex;
  flex-direction: column;
  background: var(--theme-surface, #FFFFFF);
  border-radius: 28rpx 28rpx 0 0;
  overflow: hidden;
}

.theme-panel .modal-header {
  flex: 0 0 auto;
}

.theme-list {
  flex: 1;
  min-height: 0;
  max-height: calc(78vh - 112rpx);
  padding: 14rpx 30rpx calc(34rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.theme-option {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  padding: 18rpx 0;
  border-bottom: 1px solid var(--theme-border, #F0F0F0);
}

.theme-option:last-child {
  border-bottom: none;
}

.theme-option.selected .theme-name {
  color: var(--theme-accent, #6F8F4E);
  font-weight: bold;
}

.theme-swatch {
  flex: 0 0 52rpx;
  width: 52rpx;
  height: 52rpx;
  margin-right: 18rpx;
  border: 2rpx solid rgba(0, 0, 0, 0.08);
  border-radius: 50%;
}

.theme-copy {
  flex: 1;
  min-width: 0;
}

.theme-name,
.theme-note {
  display: block;
}

.theme-name {
  color: var(--theme-text, #333333);
  font-size: 30rpx;
}

.theme-note {
  margin-top: 6rpx;
  color: var(--theme-muted, #999999);
  font-size: 22rpx;
}

.theme-check {
  margin-left: 18rpx;
  color: var(--theme-accent, #6F8F4E);
  font-size: 32rpx;
  font-weight: bold;
}
